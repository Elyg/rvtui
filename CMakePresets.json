{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-base",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-Werror -Wall"
      }
    },
    {
      "name": "apple-base",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_CXX_FLAGS": "-Werror -Wall"
      }
    },
    {
      "name": "linux-x64-Debug",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/conan-build/conan-linux-x64-clang/Debug/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-x64-Release",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/conan-build/conan-linux-x64-clang/Release/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-arm64-Debug",
      "inherits": "apple-base",
      "toolchainFile": "${sourceDir}/conan-build/conan-macos-arm64-clang/Debug/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-arm64-Release",
      "inherits": "apple-base",
      "toolchainFile": "${sourceDir}/conan-build/conan-macos-arm64-clang/Release/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64-Debug",
      "configurePreset": "linux-x64-Debug"
    },
    {
      "name": "linux-x64-Release",
      "configurePreset": "linux-x64-Release"
    },
    {
      "name": "macos-arm64-Debug",
      "configurePreset": "macos-arm64-Debug"
    },
    {
      "name": "macos-arm64-Release",
      "configurePreset": "macos-arm64-Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-x64-Debug",
      "configurePreset": "linux-x64-Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64-Release",
      "configurePreset": "linux-x64-Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-Debug",
      "configurePreset": "macos-arm64-Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-Release",
      "configurePreset": "macos-arm64-Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
